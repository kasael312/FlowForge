# ---- LLM ----
ANTHROPIC_API_KEY=
# Optional server-wide OpenAI key (users can also store their own in Settings)
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Server-side refusal fallbacks (Claude API only)
ANTHROPIC_FALLBACKS=true
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# ---- Auth ----
# Secret for signing JWT (required in production; random per process if empty)
JWT_SECRET=
# Secret for encrypting stored API keys (Fernet). Falls back to JWT_SECRET if empty.
APP_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# true behind HTTPS
COOKIE_SECURE=false
# open | first_user (only the first account can sign up) | closed
REGISTRATION=open
# Failed logins per client+email inside the window before 429
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_SECONDS=900
# Internal URL prefixes the backend may call for users (e.g. local Ollama); other targets must be public
TRUSTED_INTERNAL_URLS=http://localhost:11434,http://127.0.0.1:11434,http://host.docker.internal:11434
# Knowledge-base embeddings for the industry assistant: lexical (offline) | openai
KB_EMBEDDINGS=lexical
# stdio MCP servers run a process on the backend host: admin only
MCP_STDIO_ADMIN_ONLY=true

# ---- Backend ----
DATABASE_URL=sqlite:///./data/flowforge.db
# Directory where repos are cloned per run (mounted into the sandbox as /repo)
WORKSPACE_DIR=./data/workspaces
# Docker image used to run steps in a sandbox
SANDBOX_IMAGE=flowforge-sandbox:latest
# Default Docker network for sandboxes: none (no egress) | allowlist (egress proxy) | bridge (open)
SANDBOX_NETWORK=none
# Highest mode a flow may request (none < allowlist < bridge)
SANDBOX_MAX_NETWORK=allowlist
# Server caps for per-flow sandbox settings
SANDBOX_MAX_CPUS=2
SANDBOX_MAX_MEMORY_MB=2048
SANDBOX_MAX_TIMEOUT_SECONDS=3600
# Files under /repo/output are kept here after each run
ARTIFACTS_DIR=./data/artifacts
# Skills are materialized here before being copied into the sandbox (/skills/<name>/)
SKILLS_DIR=./data/skills
ARTIFACT_MAX_BYTES=52428800
ARTIFACT_MAX_FILES=200
MAX_STEPS_PER_RUN=50
# Pricing table for cost estimates (USD per 1M tokens), editable in the app
PRICING_FILE=./data/pricing.json
# Comma-separated whitelist of shell commands the agent may run inside the sandbox
SHELL_WHITELIST=ls,cat,grep,find,pytest,npm,npx,node,python,python3,pip,git,make
CORS_ORIGINS=http://localhost:5173

# ---- GitHub (PR creation) ----
GITHUB_TOKEN=

# ---- Frontend ----
VITE_API_URL=http://localhost:8000

# --- Billing (gói Dùng thử → Cơ bản → Pro, chuyển khoản VietQR, admin xác nhận)
BILLING_TRIAL_DAYS=30
BILLING_BANK_BIN=970436
BILLING_BANK_NAME=Vietcombank
BILLING_BANK_ACCOUNT=
BILLING_BANK_ACCOUNT_NAME=
# Cảnh báo cho admin hệ thống (connector mất kết nối, flow lỗi) POST JSON {text,title,body,workspace_id}
ALERT_WEBHOOK_URL=
